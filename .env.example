# X-Tweet-Analyzer Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================================
# TWITTER/X ACCOUNTS (for authenticated scraping)
# ============================================================
# Option 1: Single account via environment variables
TWITTER_USERNAME=your_username
TWITTER_PASSWORD=your_password
TWITTER_EMAIL=your@email.com
TWITTER_EMAIL_PASSWORD=your_email_password

# Option 2: Multiple accounts via JSON file (recommended)
# Create accounts.json with an array of account objects
# See accounts.example.json for format
ACCOUNTS_FILE=accounts.json

# ============================================================
# DATABASE
# ============================================================
DB_PATH=data/tweets.db

# ============================================================
# SCRAPING SETTINGS
# ============================================================
# Delay between requests in seconds (increase if rate limited)
RATE_LIMIT_DELAY=1.0

# Maximum retries on rate limit/error
MAX_RETRIES=5

# Default max tweets to fetch (leave empty for all)
DEFAULT_LIMIT=

# Optional Xquik API source
# Run: python main.py scrape username --source xquik
XQUIK_API_KEY=
XQUIK_BASE_URL=https://xquik.com/api/v1

# ============================================================
# OUTPUT
# ============================================================
OUTPUT_DIR=output
LOG_LEVEL=INFO
LOG_FILE=

# ============================================================
# WEB SERVER
# ============================================================
WEB_HOST=127.0.0.1
WEB_PORT=8000
DEBUG=false
